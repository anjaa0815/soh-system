# Filled in by init-env.sh — do not edit placeholders by hand.
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
DATABASE_URL=postgresql://condo:__POSTGRES_PASSWORD__@postgres/condo
REDIS_URL=redis://redis:6379/0

PORT=3000
# With a domain, run ./set-domain.sh <domain>: it sets DOMAIN (https via caddy) and SERVER_URL
SERVER_URL=__SERVER_URL__
COOKIE_SECRET=__COOKIE_SECRET__
DATA_ENCRYPTION_CONFIG={"condo_1":{"algorithm":"aes-256-gcm","secret":"__ENCRYPTION_SECRET__","compressor":"brotli","keyDeriver":"pbkdf2-sha512"}}
DATA_ENCRYPTION_VERSION_ID=condo_1

DEFAULT_LOCALE=mn
DEFAULT_CURRENCY_CODE=MNT
# Support contacts shown under the sign-in poster (hidden when not set), e.g.
# HELP_REQUISITES={"support_email":"help@hutuch.ai","support_phone":"+97699112233"}
DEFAULT_STAFF_AUTH_METHODS=["phonePassword","emailPassword"]

FILE_FIELD_ADAPTER=local
FILE_CLIENT_ID=condo
FILE_SECRET=__FILE_SECRET__
FILE_UPLOAD_CONFIG={"clients":{"condo":{"secret":"__FILE_SECRET__"}}}

FAKE_ADDRESS_SERVICE_CLIENT=true
FAKE_FINANCE_INFO_CLIENT=true
USE_LOCAL_FEATURE_FLAGS=true
DISABLE_CAPTCHA=true

# Phone confirmation with Verify.MN (the user sends the code by SMS to 144773), key from verify.mn/app/api-keys/
# VERIFY_MN_API_KEY=

# No SMS/email provider configured yet: verification codes are printed to the app log
NOTIFICATION__SEND_ALL_MESSAGES_TO_CONSOLE=true

# No separate worker container (not enough RAM): background tasks run inside the app process.
# Scheduled (cron) tasks do not run in this mode.
TESTS_FAKE_WORKER_MODE=true
