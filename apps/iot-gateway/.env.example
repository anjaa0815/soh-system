# condo GraphQL API this gateway pushes data into
CONDO_API_URL=http://localhost:4002/admin/api

# Token from a B2BAccessToken record (Keystone Admin UI -> B2BAccessToken -> create),
# tied to a B2BApp's service user. Sent as `Authorization: Bearer <token>`.
CONDO_SERVICE_TOKEN=

# Organization this gateway reports meter readings for
CONDO_ORGANIZATION_ID=

# --- MQTT adapter ---
MQTT_ENABLED=false
MQTT_BROKER_URL=mqtt://localhost:1883
# Readings are expected on topics matching this pattern, e.g. meters/<meterNumber>/reading
MQTT_TOPIC_PATTERN=meters/+/reading

# --- ONVIF adapter (IP cameras) ---
ONVIF_ENABLED=false
# Comma-separated list of camera host:port:username:password, e.g. 192.168.1.10:80:admin:secret
ONVIF_CAMERAS=

# --- RS-485 / Modbus adapter ---
RS485_ENABLED=false
RS485_SERIAL_PORT=/dev/ttyUSB0
RS485_BAUD_RATE=9600
# Comma-separated list of slaveId:meterNumber:resource:registerAddress, resource one of:
# coldWater,hotWater,electricity,heatSupply,gasSupply
RS485_DEVICES=
RS485_POLL_INTERVAL_MS=60000

# --- Parking adapter (barrier / ALPR parking server on the same LAN) ---
PARKING_ENABLED=false
# Third-party API of the parking server. It has NO authentication: keep it LAN-only.
PARKING_API_URL=http://127.0.0.1:9001/yard/third
# Parking-side car type residents are registered as (21 = monthA in a default install)
PARKING_MONTHLY_CAR_TYPE=21
# How often entry/exit records are pulled, and how often plates are reconciled with condo
PARKING_POLL_INTERVAL_MS=30000
PARKING_SYNC_INTERVAL_MS=300000
# Validity window for plates that carry no explicit validUntil
PARKING_DEFAULT_VALID_DAYS=365
# CustomField (modelName: Contact) that holds a contact's licence plates. Required.
PARKING_PLATES_CUSTOM_FIELD_ID=
# Optional CustomField (modelName: Contact, type: Json) to store each resident's last entries/exits
PARKING_HISTORY_CUSTOM_FIELD_ID=
# id of the B2BApp this gateway's service token belongs to (needed to write CustomValues)
CONDO_B2B_APP_ID=

# --- Plate editor (small web screen for the security desk / HOA office) ---
PARKING_ADMIN_ENABLED=false
# 127.0.0.1 = this machine only. Use the machine's LAN address to open it to the office network.
PARKING_ADMIN_HOST=127.0.0.1
PARKING_ADMIN_PORT=8091
# Required, 4+ characters. Everyone who edits plates shares this PIN.
PARKING_ADMIN_PIN=
